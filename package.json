{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "imports": {
    "#i18n": {
      "react-server": "./src/lib/server/i18n/index.ts",
      "default": "./src/lib/client/i18n/index.tsx"
    }
  },
  "scripts": {
    "build": "next build",
    "check": "bun run fmt && bun run lint && bun run typecheck",
    "dev": "next dev",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "gen:icons": "svgr --out-dir src/components/icons --typescript --icon --replace-attr-values \"#000=currentColor\" public/svg-icons",
    "lint": "oxlint . --report-unused-disable-directives-severity warn",
    "lint:fix": "oxlint . --fix --report-unused-disable-directives-severity warn",
    "menu": "bun ./scripts/menu.ts",
    "prepare": "husky",
    "start": "next start",
    "supabase:env": "bun ./scripts/supabase-env.ts",
    "supabase:setup": "bunx supabase start && bun run supabase:env",
    "supabase:types": "bunx supabase gen types --local --schema public > src/types/supabase.ts",
    "test": "bun test",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.47",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/markdown": "1.7.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/speed-insights": "^2.0.0",
    "agentation-mcp": "1.2.0",
    "ai": "^7.0.97",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "dayjs": "^1.11.23",
    "es-toolkit": "1.52.0",
    "fflate": "^0.8.3",
    "framer-motion": "^13.1.1",
    "franc-min": "^6.2.0",
    "intl-messageformat": "^10.7.18",
    "jotai": "2.20.3",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "opencc-js": "^1.4.2",
    "prism-themes": "^1.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-prism-plus": "^2.0.2",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sass": "^1.97.3",
    "sonner": "^2.0.7",
    "supabase": "^2.116.0",
    "tailwind-merge": "^3.4.0",
    "ts-pattern": "^5.9.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "agentation": "3.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "^9.1.7",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss-scss": "^4.0.9",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "type-fest": "5.8.0",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "supabase",
    "unrs-resolver"
  ]
}
