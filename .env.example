# Supabase Configuration
# For local development, get these values from bunx supabase status.
# For deployment, get them from the hosted Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional: timezone used for all date formatting and dashboard datetime inputs.
# Fallback: America/New_York when empty or invalid.
NEXT_PUBLIC_APP_TIMEZONE=America/New_York
# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret

# Optional post translation preview (server only).
TRANSLATION_AI_API_KEY=
TRANSLATION_AI_BASE_URL=
TRANSLATION_AI_MODEL=
